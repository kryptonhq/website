---
import mark from '../assets/mark-dark.svg';
---

<header class="nav">
  <div class="nav__inner">
    <a class="nav__brand" href="/">
      <img src={mark.src} alt="" width="26" height="26" />
      <span class="nav__wordmark">Krypton</span>
    </a>

    <nav class="nav__links" aria-label="Primary">
      <a href="/runtime/" data-product="runtime">Runtime</a>
      <a href="/loupe/" data-product="loupe">Loupe</a>
      <a
        href="https://github.com/kryptonhq"
        rel="noopener"
        class="nav__ghost">GitHub</a
      >
    </nav>
  </div>
</header>

<style>
  .nav {
    position: sticky;
    top: 0;
    z-index: 40;
    backdrop-filter: blur(14px) saturate(160%);
    background: color-mix(in srgb, var(--kr-ink) 72%, transparent);
    border-bottom: 1px solid var(--kr-line);
  }

  .nav__inner {
    max-width: var(--kr-measure);
    margin-inline: auto;
    padding: 0.85rem var(--kr-gutter);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }

  .nav__brand {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    text-decoration: none;
    color: var(--kr-text);
  }

  .nav__wordmark {
    font-weight: 700;
    font-size: 1.02rem;
    letter-spacing: -0.03em;
  }

  .nav__links {
    display: flex;
    align-items: center;
    gap: 0.35rem;
  }

  /* Each product link carries its own accent on hover, so the colour
     coding starts before the visitor has scrolled anywhere. */
  .nav__links a {
    font-family: var(--kr-font-mono);
    font-size: 0.76rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    text-decoration: none;
    color: var(--kr-text-muted);
    padding: 0.45rem 0.7rem;
    border-radius: var(--kr-radius-sm);
    border: 1px solid transparent;
    transition:
      color 0.18s var(--kr-ease),
      border-color 0.18s var(--kr-ease),
      background 0.18s var(--kr-ease);
  }

  .nav__links a:hover,
  .nav__links a:focus-visible {
    color: var(--kr-accent);
    border-color: var(--kr-line-strong);
    background: var(--kr-accent-soft);
  }

  @media (max-width: 34rem) {
    .nav__ghost {
      display: none;
    }
  }
</style>
