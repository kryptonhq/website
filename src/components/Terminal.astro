---
interface Props {
  title?: string;
  /** Pre-tokenised terminal body. Passed as HTML rather than through a
      slot because JSX collapses the leading indentation that makes a
      wrapped shell command readable. */
  html: string;
}

const { title = 'krypton ~ zsh', html } = Astro.props;
---

<div class="term">
  <div class="term__bar">
    <span class="term__dot term__dot--red"></span>
    <span class="term__dot term__dot--amber"></span>
    <span class="term__dot term__dot--green"></span>
    <span class="term__title">{title}</span>
  </div>
  <pre class="term__body"><code set:html={html} /></pre>
</div>

<style>
  .term {
    background: #0a0d14;
    border: 1px solid var(--kr-line);
    border-radius: var(--kr-radius);
    overflow: hidden;
    font-family: var(--kr-font-mono);
    font-size: 0.795rem;
    line-height: 1.62;
    color: #d7dde9;
    box-shadow:
      0 1px 0 rgb(255 255 255 / 0.04) inset,
      0 24px 60px -28px rgb(0 0 0 / 0.9);
  }

  .term__bar {
    background: linear-gradient(180deg, #171c28 0%, #10141d 100%);
    padding: 0.6rem 0.8rem;
    display: flex;
    align-items: center;
    gap: 0.4rem;
    border-bottom: 1px solid var(--kr-line);
  }

  .term__dot {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    box-shadow: inset 0 0 0 1px rgb(0 0 0 / 0.28);
  }
  .term__dot--red {
    background: #ff5f57;
  }
  .term__dot--amber {
    background: #febc2e;
  }
  .term__dot--green {
    background: #28c840;
  }

  .term__title {
    flex: 1;
    text-align: center;
    color: var(--kr-text-faint);
    font-size: 0.68rem;
    letter-spacing: 0.04em;
    margin-right: 2.2rem; /* counterweight to the dots so text centres */
  }

  .term__body {
    margin: 0;
    padding: 1.05rem 1.15rem 1.2rem;
    overflow-x: auto;
    white-space: pre;
    tab-size: 2;
  }
</style>

<style is:global>
  /* Token colours for terminal contents. Global because the markup is
     passed in through the slot from the calling page. */
  .term__body .c {
    color: #5b6377;
    font-style: italic;
  }
  .term__body .p {
    color: var(--kr-indigo-400);
    user-select: none;
  }
  .term__body .k {
    color: #7aa7ff;
    font-weight: 600;
  }
  .term__body .s {
    color: var(--kr-teal-300);
  }
  .term__body .o {
    color: #8a93a9;
  }
</style>
