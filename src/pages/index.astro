---
import Landing from '../layouts/Landing.astro';
import Footer from '../components/Footer.astro';
import kryptonDark from '../assets/mark-dark.svg';
import kryptonLight from '../assets/mark-light.svg';
import loupe from '../assets/loupe-mark.svg';

// Two products, one door each. Everything that used to live here — the
// hero, the animated lattice, the terminal demo, twelve feature cards —
// was the site explaining itself before anyone had asked a question.
// The docs explain; this page routes.
const products = [
  {
    id: 'loupe',
    name: 'Loupe',
    mark: loupe.src,
    markLight: loupe.src,
    tagline: 'A desktop client for reading and operating any Kubernetes cluster.',
    href: '/loupe/',
    repo: 'https://github.com/kryptonhq/loupe',
  },
  {
    id: 'runtime',
    name: 'Runtime',
    mark: kryptonDark.src,
    markLight: kryptonLight.src,
    tagline: 'Deploy AI agents, self-hosted LLMs and MCP servers on Kubernetes.',
    href: '/runtime/',
    repo: 'https://github.com/kryptonhq/runtime',
  },
];
---

<Landing
  title="Krypton — open-source projects for the Cloud"
  description="Open-source projects for the Cloud. Loupe is a desktop client for reading and operating any Kubernetes cluster. Krypton Runtime deploys AI agents, self-hosted LLMs and MCP servers. Both Apache-2.0."
>
  <main id="main" class="home">
    <header class="brand">
      <h1 class="brand__name">Krypton</h1>
      <p class="brand__tag">Open-source projects for the Cloud.</p>
    </header>

    <ul class="grid">
      {
        products.map((p) => (
          <li>
            <a class="card" href={p.href} data-product={p.id}>
              <img class="card__mark card__mark--dark" src={p.mark} alt="" width="44" height="44" />
              <img class="card__mark card__mark--light" src={p.markLight} alt="" width="44" height="44" />
              <h2 class="card__name">{p.name}</h2>
              <p class="card__tag">{p.tagline}</p>
              <span class="card__go">
                Documentation
                <svg viewBox="0 0 16 16" width="13" height="13" aria-hidden="true">
                  <path
                    d="M3 8h9M8.5 4l4 4-4 4"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.6"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  />
                </svg>
              </span>
            </a>
            <a class="repo" href={p.repo} rel="noopener">
              Source on GitHub
            </a>
          </li>
        ))
      }
    </ul>
  </main>

  <Footer />
</Landing>

<style>
  .home {
    max-width: 62rem;
    margin: 0 auto;
    padding: clamp(3.5rem, 12vh, 8rem) 1.5rem 4rem;
  }

  /* Row one: who this is. */
  .brand {
    text-align: center;
    margin-bottom: clamp(2.5rem, 7vh, 4.5rem);
  }

  .brand__name {
    font-size: clamp(2.1rem, 5vw, 2.9rem);
    line-height: 1.1;
    letter-spacing: -0.03em;
    margin: 0 0 0.5rem;
  }

  .brand__tag {
    margin: 0;
    color: var(--kr-text-muted);
    font-size: 1rem;
  }

  /* Row two: where to go. */
  .grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 1.25rem;
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .grid > li {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.75rem;
  }

  .card {
    display: block;
    width: 100%;
    padding: 2rem 1.75rem 1.75rem;
    border: 1px solid var(--kr-line);
    border-radius: 14px;
    background: var(--kr-surface-1);
    text-decoration: none;
    color: inherit;
    transition:
      border-color 160ms ease,
      background 160ms ease,
      transform 160ms ease;
  }

  .card:hover,
  .card:focus-visible {
    border-color: color-mix(in srgb, var(--kr-accent) 55%, transparent);
    background: var(--kr-surface-2);
    transform: translateY(-2px);
  }

  .card__mark {
    display: block;
    margin-bottom: 1.1rem;
  }

  /* The Krypton mark is white on transparent in one file and indigo in
     the other. Showing the wrong one loses it against the page. */
  .card__mark--light {
    display: none;
  }

  :root[data-theme='light'] .card__mark--dark {
    display: none;
  }

  :root[data-theme='light'] .card__mark--light {
    display: block;
  }

  .card__name {
    font-size: 1.35rem;
    letter-spacing: -0.02em;
    margin: 0 0 0.4rem;
  }

  .card__tag {
    margin: 0 0 1.4rem;
    color: var(--kr-text-muted);
    font-size: 0.95rem;
    line-height: 1.55;
  }

  .card__go {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.9rem;
    font-weight: 600;
    color: var(--kr-accent);
  }

  .card:hover .card__go svg {
    transform: translateX(2px);
  }

  .card__go svg {
    transition: transform 160ms ease;
  }

  .repo {
    font-size: 0.8rem;
    color: var(--kr-text-faint);
    text-decoration: none;
  }

  .repo:hover {
    color: var(--kr-text-muted);
    text-decoration: underline;
  }

  /* One column below the point where two would be a pair of slivers. */
  @media (max-width: 40rem) {
    .grid {
      grid-template-columns: 1fr;
    }
  }
</style>
